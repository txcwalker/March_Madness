# Environments
.venv/
venv/
__pycache__/
*.pyc

# Jupyter
.ipynb_checkpoints/

# IDE
.idea/
.vscode/

# Data -- all local-only. Kaggle competition data may carry redistribution
# restrictions, so raw inputs stay untracked too, not just generated output.
# Re-populate data/raw/<year>/ locally (Kaggle download + KenPom paste) after
# cloning; see README.md/DEVELOPMENT.md. (Ignoring contents via "data/raw/*"
# rather than the "data/raw/" directory itself, so the .gitkeep negation
# below actually works -- git won't descend into a fully-ignored directory
# to evaluate a negation inside it.)
data/raw/*
!data/raw/.gitkeep
data/processed/
data/outputs/
reports/*.html

# Packaging
*.egg-info/
build/
dist/

# Test artifacts
.pytest_cache/

# OS
.DS_Store
Thumbs.db
